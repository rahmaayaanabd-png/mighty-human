// Prisma schema for mighty-human
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  headline     String?
  bio          String?
  industry     String?
  currentRole  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts Post[]
}

enum PostType {
  EXPERIENCE
  RESOURCE
}

enum ResourceKind {
  ARTICLE
  VIDEO
  PODCAST
  TOOL
  OTHER
}

model Post {
  id       String   @id @default(cuid())
  authorId String
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type     PostType
  title    String
  body     String
  industry String

  // Per-post signal from the author, not a blanket account setting.
  openToChat Boolean @default(false)

  resourceUrl  String?
  resourceKind ResourceKind?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industry])
  @@index([type])
  @@index([authorId])
}

// Resources pulled in from external search/video APIs for a given industry.
// Kept separate from Post since these have no local author or "open to chat".
model ExternalResource {
  id           String       @id @default(cuid())
  title        String
  description  String?
  url          String       @unique
  industry     String
  resourceKind ResourceKind
  sourceName   String
  createdAt    DateTime     @default(now())

  @@index([industry])
}

// Tracks the last time we fetched external resources for an industry,
// so we only hit the search/video APIs periodically instead of per view.
model IndustryFetchCache {
  industry      String   @id
  lastFetchedAt DateTime
}
