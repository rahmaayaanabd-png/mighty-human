# Local dev uses SQLite - no setup needed. Point this at a Postgres
# connection string ("postgresql://...") when you're ready for a real DB.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional: powers the "From around the web" section on the Industries tab.
# Leave blank to skip external resources entirely - nothing else breaks.
GOOGLE_API_KEY=""
GOOGLE_CSE_ID=""
YOUTUBE_API_KEY=""
